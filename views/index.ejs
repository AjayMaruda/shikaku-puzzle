<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shikaku Puzzle</title>
  <meta name="description" content="Play Shikaku, the rectangle tiling puzzle game." />
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white min-h-screen flex flex-col items-center justify-start py-8 px-4">

  <h1 class="text-4xl font-bold mb-2 text-indigo-400">Shikaku Puzzle</h1>
  <p class="text-gray-400 mb-6">Fill the grid with rectangles. Each number shows the rectangle area.</p>

  <div id="setup" class="flex gap-4 mb-6 items-end">
    <div>
      <label class="block text-sm text-gray-400 mb-1">Width (4-12)</label>
      <input id="boardWidth" type="number" value="6" min="4" max="12"
        class="w-20 bg-gray-800 border border-gray-600 rounded px-2 py-1 text-center" />
    </div>
    <div>
      <label class="block text-sm text-gray-400 mb-1">Height (4-12)</label>
      <input id="boardHeight" type="number" value="6" min="4" max="12"
        class="w-20 bg-gray-800 border border-gray-600 rounded px-2 py-1 text-center" />
    </div>
    <button id="btnNewGame"
      class="bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded font-semibold transition">
      New Game
    </button>
  </div>

  <div class="flex gap-6 mb-4 text-sm text-gray-300">
    <span>Board: <span id="statusBoardId" class="text-indigo-300 font-mono">-</span></span>
    <span>Timer: <span id="statusTimer" class="text-yellow-300 font-mono">0s</span></span>
    <span>Status: <span id="statusMsg" class="text-green-300">Start a new game</span></span>
  </div>

  <div id="actionBar" class="hidden flex gap-3 mb-6 flex-wrap justify-center">
    <button id="btnGenRect" class="bg-purple-700 hover:bg-purple-600 px-3 py-1.5 rounded transition text-sm">Generate Rectangles</button>
    <button id="btnSnap" class="bg-green-700 hover:bg-green-600 px-3 py-1.5 rounded transition text-sm">Snap and Lock Selected</button>
    <button id="btnCheck" class="bg-blue-700 hover:bg-blue-600 px-3 py-1.5 rounded transition text-sm">Check Win</button>
    <button id="btnReset" class="bg-red-700 hover:bg-red-600 px-3 py-1.5 rounded transition text-sm">Reset</button>
    <button id="btnStopTimer" class="bg-yellow-700 hover:bg-yellow-600 px-3 py-1.5 rounded transition text-sm">Stop Timer</button>
  </div>

  <div id="board" class="grid gap-0 border-2 border-gray-600" style="display:none;"></div>

  <div id="winBanner" class="hidden mt-6 bg-green-800 border border-green-500 rounded-lg px-8 py-4 text-center">
    <p class="text-2xl font-bold text-green-300">Puzzle Solved!</p>
    <p id="winTime" class="text-gray-300 mt-1"></p>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/game.js"></script>
</body>
</html>